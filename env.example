# Supabase Configuration (Client Side)
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI Configuration (Server Side - Vercel Environment Variables)
# Required for API endpoints
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-mini

# Optional: Supabase service role key (only for server/backend operations)
# Do NOT expose in client-side code or browser
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

